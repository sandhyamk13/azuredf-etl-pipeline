{
	"name": "PL_Plexis_Batch_Load",
	"properties": {
		"description": "Thin orchestrator. Owns batch identity, the duplicate gate and the terminal state. All data movement lives in PL_Plexis_Batch_Body so a single failure edge can cover the whole load.",
		"activities": [
			{
				"name": "SV_BatchKey",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "vBatchKey",
					"value": {
						"value": "@concat('PLEXIS-', pipeline().parameters.BatchYear, '-', pipeline().parameters.BatchMonth, if(empty(pipeline().parameters.BatchDate), '', concat('-', pipeline().parameters.BatchDate)))",
						"type": "Expression"
					}
				}
			},
			{
				"name": "VAL_BatchReady",
				"type": "Validation",
				"dependsOn": [
					{
						"activity": "SV_BatchKey",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [
					{
						"name": "why",
						"value": "Blocks until Plexis has written the control file. Guarantees all files finished uploading before any of them is read."
					}
				],
				"typeProperties": {
					"dataset": {
						"referenceName": "DS_Plexis_Binary_File",
						"type": "DatasetReference",
						"parameters": {
							"ContainerName": {
								"value": "@pipeline().parameters.ContainerName",
								"type": "Expression"
							},
							"FolderPath": {
								"value": "@pipeline().parameters.BatchFolder",
								"type": "Expression"
							},
							"FileName": "BATCH_READY.txt"
						}
					},
					"timeout": "0.01:00:00",
					"sleep": 30,
					"minimumSize": 1
				}
			},
			{
				"name": "LKP_CheckBatchStatus",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "VAL_BatchReady",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.02:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 60,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [
					{
						"name": "why",
						"value": "Lookup not Stored Procedure: the SP activity returns no output, and we need the verdict."
					}
				],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderStoredProcedureName": "[etl].[sp_Check_Batch_Status]",
						"storedProcedureParameters": {
							"BatchKey": {
								"type": "String",
								"value": {
									"value": "@variables('vBatchKey')",
									"type": "Expression"
								}
							},
							"AllowReprocess": {
								"type": "Int32",
								"value": {
									"value": "@if(pipeline().parameters.ReprocessFlag, 1, 0)",
									"type": "Expression"
								}
							}
						},
						"queryTimeout": "00:05:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_SQLMI_Table",
						"type": "DatasetReference",
						"parameters": {
							"SchemaName": "etl",
							"TableName": "Batch_Load"
						}
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "IF_CanProceed",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "LKP_CheckBatchStatus",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(activity('LKP_CheckBatchStatus').output.firstRow.CanProceed, 1)",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "FAIL_DuplicateBatch",
							"type": "Fail",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"message": {
									"value": "@concat('Batch ', variables('vBatchKey'), ' blocked: ', coalesce(activity('LKP_CheckBatchStatus').output.firstRow.BlockReason, 'unknown'))",
									"type": "Expression"
								},
								"errorCode": "PLX_DUPLICATE_BATCH"
							}
						}
					]
				}
			},
			{
				"name": "LKP_RegisterBatch",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "IF_CanProceed",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.02:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 60,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [
					{
						"name": "why",
						"value": "The database allocates Batch_Id. Guarantees uniqueness under concurrency without any locking logic in ADF."
					}
				],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderStoredProcedureName": "[etl].[sp_Register_Batch]",
						"storedProcedureParameters": {
							"BatchKey": {
								"type": "String",
								"value": {
									"value": "@variables('vBatchKey')",
									"type": "Expression"
								}
							},
							"BatchYear": {
								"type": "String",
								"value": {
									"value": "@pipeline().parameters.BatchYear",
									"type": "Expression"
								}
							},
							"BatchMonth": {
								"type": "String",
								"value": {
									"value": "@pipeline().parameters.BatchMonth",
									"type": "Expression"
								}
							},
							"BatchDate": {
								"type": "String",
								"value": {
									"value": "@pipeline().parameters.BatchDate",
									"type": "Expression"
								}
							},
							"BatchFolderPath": {
								"type": "String",
								"value": {
									"value": "@pipeline().parameters.BatchFolder",
									"type": "Expression"
								}
							},
							"PipelineName": {
								"type": "String",
								"value": {
									"value": "@pipeline().Pipeline",
									"type": "Expression"
								}
							},
							"PipelineRunId": {
								"type": "Guid",
								"value": {
									"value": "@pipeline().RunId",
									"type": "Expression"
								}
							},
							"TriggerName": {
								"type": "String",
								"value": {
									"value": "@pipeline().TriggerName",
									"type": "Expression"
								}
							},
							"TriggerTime": {
								"type": "DateTime",
								"value": {
									"value": "@pipeline().TriggerTime",
									"type": "Expression"
								}
							},
							"IsReprocess": {
								"type": "Int32",
								"value": {
									"value": "@if(pipeline().parameters.ReprocessFlag, 1, 0)",
									"type": "Expression"
								}
							},
							"ReprocessReason": {
								"type": "String",
								"value": {
									"value": "@pipeline().parameters.ReprocessReason",
									"type": "Expression"
								}
							},
							"ApprovedBy": {
								"type": "String",
								"value": {
									"value": "@pipeline().parameters.ReprocessApprovedBy",
									"type": "Expression"
								}
							}
						},
						"queryTimeout": "00:05:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_SQLMI_Table",
						"type": "DatasetReference",
						"parameters": {
							"SchemaName": "etl",
							"TableName": "Batch_Load"
						}
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "SV_BatchId",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "LKP_RegisterBatch",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "vBatchId",
					"value": {
						"value": "@string(activity('LKP_RegisterBatch').output.firstRow.BatchId)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "SP_ReverseOldBatch",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "SV_BatchId",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [
					{
						"name": "why",
						"value": "On an approved reprocess, prior DATA is removed. Prior AUDIT rows are kept."
					}
				],
				"typeProperties": {
					"expression": {
						"value": "@pipeline().parameters.ReprocessFlag",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "SP_Reverse",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [],
							"policy": {
								"timeout": "0.02:00:00",
								"retry": 2,
								"retryIntervalInSeconds": 60,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "[etl].[sp_Reverse_Batch]",
								"storedProcedureParameters": {
									"BatchKey": {
										"value": {
											"value": "@variables('vBatchKey')",
											"type": "Expression"
										},
										"type": "String"
									}
								}
							}
						}
					]
				}
			},
			{
				"name": "EP_BatchBody",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "SP_ReverseOldBatch",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [
					{
						"name": "why",
						"value": "One child call means ONE failure edge covers Member, Provider, Claims and reconciliation. ADF has no try/finally."
					}
				],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_Plexis_Batch_Body",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"BatchId": {
							"value": "@int(variables('vBatchId'))",
							"type": "Expression"
						},
						"ContainerName": {
							"value": "@pipeline().parameters.ContainerName",
							"type": "Expression"
						},
						"BatchFolder": {
							"value": "@pipeline().parameters.BatchFolder",
							"type": "Expression"
						},
						"MemberFileName": {
							"value": "@pipeline().parameters.MemberFileName",
							"type": "Expression"
						},
						"ProviderFileName": {
							"value": "@pipeline().parameters.ProviderFileName",
							"type": "Expression"
						},
						"ClaimsFileName": {
							"value": "@pipeline().parameters.ClaimsFileName",
							"type": "Expression"
						},
						"LoadMember": {
							"value": "@pipeline().parameters.LoadMember",
							"type": "Expression"
						},
						"LoadProvider": {
							"value": "@pipeline().parameters.LoadProvider",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "SP_CompleteBatch",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "EP_BatchBody",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.02:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 60,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[etl].[sp_Complete_Batch]",
					"storedProcedureParameters": {
						"BatchId": {
							"value": {
								"value": "@variables('vBatchId')",
								"type": "Expression"
							},
							"type": "Int64"
						}
					}
				}
			},
			{
				"name": "EP_ArchiveFiles",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "SP_CompleteBatch",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [
					{
						"name": "why",
						"value": "Archive only after the batch is marked COMPLETED. If archive fails, the data is already safe and only the move needs replaying."
					}
				],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_Archive_Batch_Files",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"ContainerName": {
							"value": "@pipeline().parameters.ContainerName",
							"type": "Expression"
						},
						"SourceFolder": {
							"value": "@pipeline().parameters.BatchFolder",
							"type": "Expression"
						},
						"TargetFolder": {
							"value": "@replace(pipeline().parameters.BatchFolder, 'landing', 'archive')",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "SV_ErrorMessage",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "EP_BatchBody",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "vErrorMessage",
					"value": {
						"value": "@concat('Batch ', variables('vBatchKey'), ' failed in PL_Plexis_Batch_Body. RunId=', activity('EP_BatchBody').output.pipelineRunId, '. ', string(activity('EP_BatchBody').error.message))",
						"type": "Expression"
					}
				}
			},
			{
				"name": "SP_FailBatch",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "SV_ErrorMessage",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.00:10:00",
					"retry": 3,
					"retryIntervalInSeconds": 30
				},
				"userProperties": [
					{
						"name": "why",
						"value": "retry=3: the audit write must survive a transient SQL MI blip, otherwise the batch is stuck at IN_PROGRESS and blocks the next run."
					}
				],
				"typeProperties": {
					"storedProcedureName": "[etl].[sp_Fail_Batch]",
					"storedProcedureParameters": {
						"BatchId": {
							"value": {
								"value": "@variables('vBatchId')",
								"type": "Expression"
							},
							"type": "Int64"
						},
						"ErrorMessage": {
							"value": {
								"value": "@variables('vErrorMessage')",
								"type": "Expression"
							},
							"type": "String"
						}
					}
				}
			},
			{
				"name": "FAIL_Pipeline",
				"type": "Fail",
				"dependsOn": [
					{
						"activity": "SP_FailBatch",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [
					{
						"name": "why",
						"value": "Without this, handling the error would leave the pipeline RUN marked Succeeded and Azure Monitor would never alert."
					}
				],
				"typeProperties": {
					"message": {
						"value": "@variables('vErrorMessage')",
						"type": "Expression"
					},
					"errorCode": "PLX_BATCH_FAILED"
				}
			}
		],
		"parameters": {
			"ContainerName": {
				"type": "string",
				"defaultValue": "plexis"
			},
			"BatchYear": {
				"type": "string"
			},
			"BatchMonth": {
				"type": "string"
			},
			"BatchDate": {
				"type": "string"
			},
			"BatchFolder": {
				"type": "string"
			},
			"MemberFileName": {
				"type": "string"
			},
			"ProviderFileName": {
				"type": "string"
			},
			"ClaimsFileName": {
				"type": "string"
			},
			"LoadMember": {
				"type": "bool",
				"defaultValue": false
			},
			"LoadProvider": {
				"type": "bool",
				"defaultValue": false
			},
			"ReprocessFlag": {
				"type": "bool",
				"defaultValue": false
			},
			"ReprocessReason": {
				"type": "string"
			},
			"ReprocessApprovedBy": {
				"type": "string"
			}
		},
		"variables": {
			"vBatchKey": {
				"type": "String"
			},
			"vBatchId": {
				"type": "String"
			},
			"vErrorMessage": {
				"type": "String"
			}
		},
		"folder": {
			"name": "Plexis/Master"
		},
		"annotations": [
			"plexis",
			"master",
			"batch"
		]
	}
}