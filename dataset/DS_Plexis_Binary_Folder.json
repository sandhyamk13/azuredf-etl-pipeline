{
  "name": "DS_Plexis_Binary_Folder",
  "properties": {
    "linkedServiceName": {
      "referenceName": "LS_Plexis_Blob",
      "type": "LinkedServiceReference"
    },
    "parameters": {
      "ContainerName": {
        "type": "string"
      },
      "FolderPath": {
        "type": "string"
      }
    },
    "annotations": [
      "plexis"
    ],
    "type": "Binary",
    "typeProperties": {
      "location": {
        "type": "AzureBlobStorageLocation",
        "folderPath": {
          "value": "@dataset().FolderPath",
          "type": "Expression"
        },
        "container": {
          "value": "@dataset().ContainerName",
          "type": "Expression"
        }
      }
    }
  }
}